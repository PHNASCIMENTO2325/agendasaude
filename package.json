{
  "name": "agendasaude",
  "version": "1.0.0",
  "description": "AgendaSaude - API REST para agendamento de consultas em unidades de saude (Eletiva IV - Projeto Multidisciplinar de Analise e Desenvolvimento de Sistemas)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
